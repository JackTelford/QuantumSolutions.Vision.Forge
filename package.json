{
  "name": "vision-forge",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code skill that turns an English prompt into a finished video or still using only code: HTML/CSS, Three.js and Blender rendered deterministically, assembled and checked with ffmpeg.",
  "license": "Apache-2.0",
  "author": "Quantum Solutions",
  "repository": {
    "type": "git",
    "url": "https://github.com/JackTelford/QuantumSolutions.Vision.Forge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.browser.json",
    "lint": "node scripts/lint.ts",
    "schema:gen": "node scripts/gen-types.ts",
    "schema:check": "node scripts/gen-types.ts --check",
    "licenses": "node scripts/licenses.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run schema:check && npm run licenses && npm test",
    "probe": "node scripts/probes/run.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "playwright-core": "1.64.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3"
  }
}
