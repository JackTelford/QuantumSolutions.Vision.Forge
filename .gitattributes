# Line endings: LF everywhere (bash scripts, Python, ffmpeg concat lists and
# TypeScript all expect it). Windows launchers are the one exception.
*            text=auto eol=lf
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Binary media, fonts and model files: never normalize, never diff as text.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.gif        binary
*.hdr        binary
*.exr        binary
*.glb        binary
*.blend      binary
*.wav        binary
*.mp3        binary
*.mp4        binary
*.mov        binary
*.mkv        binary
*.ttf        binary
*.otf        binary
*.woff       binary
*.woff2      binary
*.onnx       binary
*.ico        binary
